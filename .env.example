# yd-adapter — конфигурация. Скопировать в .env рядом с бинарником (chmod 600).
# Значения из окружения приоритетнее файла (systemd EnvironmentFile).

# --- Яндекс.Диск ---
# Серверный токен, выдан для device_id=server-echo-144 (docs/token-notes.md)
YD_TOKEN=
# Корень канала на Диске
YD_ROOT=/echo

# --- локальная очередь воркеров ---
QUEUE_DIR=/opt/echo-bot/queue
STATE_FILE=/opt/echo-bot/yd-adapter/state.json
# Пауза между проходами цикла, секунды (замер A4: 200 запросов без 429 на ~1 req/s)
POLL_INTERVAL=10
# Чистка archive/, дни (возраст — из ts в имени файла)
RETENTION_DAYS=30
# Возврат зависших claim'ов в inbox, секунды (heartbeat воркера — 60 с)
CLAIM_TIMEOUT=1800

# --- LLM для конвертов kind:chat (ключ бота, см. README LazDeltaChatBot) ---
LLM_BASE_URL=https://api.neuraldeep.ru/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_SYSTEM=
LLM_TIMEOUT=120

# --- опционально: explicit-flow (если срок жизни токена окажется коротким) ---
# Адаптер их не читает напрямую; держим вместе, перевыпуск описан в docs/token-notes.md
# YD_CLIENT_ID=
# YD_CLIENT_SECRET=
# YD_REFRESH_TOKEN=

# --- push о новых ответах (ntfy, PROTOCOL.md §7) ---
# Топик — общий секрет адаптера и echo-pult (lib/config.dart). Пусто — push выключен.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# --- reclaim: защита от прогонов по кругу ---
# Сколько раз задачу можно вернуть в inbox, прежде чем запарковать в parked/
# (0 — не парковать; результат уже готов -> claim убирается без перезапуска)
RECLAIM_PARK_AFTER=3
